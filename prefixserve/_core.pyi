from collections.abc import Sequence
from typing import Final, TypeAlias

import numpy as np
import numpy.typing as npt

_Ints: TypeAlias = Sequence[int] | npt.NDArray[np.int32]

BLOCK_SIZE: Final[int]

class CoreError(RuntimeError):
    """Broken ref counting or a bad block id. Always a scheduler bug."""

class BlockManager:
    def __init__(self, num_blocks: int) -> None: ...
    def allocate(self) -> int | None: ...
    def allocate_many(self, n: int) -> list[int] | None: ...
    def incref(self, block_id: int) -> None: ...
    def decref(self, block_id: int) -> None: ...
    def decref_many(self, block_ids: _Ints) -> None: ...
    def ref_count(self, block_id: int) -> int: ...
    @property
    def num_free(self) -> int: ...
    @property
    def num_blocks(self) -> int: ...
    def check_invariants(self) -> None: ...

class RadixTree:
    def __init__(self, block_manager: BlockManager) -> None: ...
    def match_prefix(self, tokens: _Ints) -> tuple[int, list[int]]: ...
    def insert(self, tokens: _Ints, block_ids: _Ints) -> int: ...
    def evict(self, num_blocks: int) -> int: ...
    def is_cached(self, block_id: int) -> bool: ...
    @property
    def num_cached_blocks(self) -> int: ...
    def check_invariants(self) -> None: ...
